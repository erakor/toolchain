{
  "name": "@erakor/toolchain",
  "version": "1.1.0",
  "private": true,
  "description": "Shared lint, format and TypeScript settings for the erakor repos.",
  "license": "MIT",
  "files": [
    "oxfmt",
    "oxlint",
    "tsconfig"
  ],
  "type": "module",
  "exports": {
    "./oxfmt": {
      "types": "./oxfmt/index.d.mts",
      "default": "./oxfmt/index.mjs"
    },
    "./oxlint/*": "./oxlint/*",
    "./tsconfig/*": "./tsconfig/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --ignore-pattern test/fixtures",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  },
  "peerDependencies": {
    "oxfmt": ">=0.79.0",
    "oxlint": ">=1.94.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}
