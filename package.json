{
  "name": "@erakor/toolchain",
  "version": "1.5.0",
  "private": true,
  "description": "Shared lint, format, TypeScript and CI settings for the erakor repos.",
  "license": "MIT",
  "files": [
    "bin",
    "knip",
    "oxfmt",
    "oxlint",
    "tsconfig"
  ],
  "type": "module",
  "bin": {
    "erakor-storybook-smoke": "./bin/storybook-smoke.mjs"
  },
  "exports": {
    "./knip/shadcn": {
      "types": "./knip/shadcn.d.mts",
      "default": "./knip/shadcn.mjs"
    },
    "./knip/storybook": {
      "types": "./knip/storybook.d.mts",
      "default": "./knip/storybook.mjs"
    },
    "./oxfmt": {
      "types": "./oxfmt/index.d.mts",
      "default": "./oxfmt/index.mjs"
    },
    "./oxlint/*": "./oxlint/*",
    "./tsconfig/*": "./tsconfig/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --ignore-pattern test/fixtures",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test test/*.test.mjs",
    "consumers:doctor": "node scripts/doctor.mjs",
    "consumers:bump": "node scripts/bump.mjs",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "eslint-plugin-storybook": "^10.6.8",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "eslint-plugin-storybook": ">=10",
    "oxfmt": ">=0.79.0",
    "oxlint": ">=1.94.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-storybook": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}
